{% extends 'base.html.twig' %}

{% block title %}{{ product.name }}{% endblock %}

{% block body %}
    <p><a href="{{ path('product_index') }}">← Retour au catalogue</a></p>

    <h1>{{ product.name }}</h1>
    <p>Catégorie : {{ product.category.name }}</p>

    <p><strong>{{ product.price|price }}</strong></p>

    {% if product.inStock %}
        <p>En stock</p>

        <form method="post" action="{{ path('cart_add', {id: product.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('cart') }}">

            <label for="quantity">Quantité</label>
            <input type="number" id="quantity" name="quantity" value="1" min="1" max="{{ product.stock }}" required>

            <button type="submit">Ajouter au panier</button>
        </form>
    {% else %}
        <p>Rupture de stock</p>
    {% endif %}

    {% if product.description %}
        <p>{{ product.description }}</p>
    {% endif %}
{% endblock %}