{% extends 'base.html.twig' %}

{% block title %}{{ product.name }}{% endblock %}

{% block body %}
    <nav class="breadcrumb" aria-label="Fil d'Ariane">
        <a href="{{ path('product_index') }}">Catalogue</a>
        <span aria-hidden="true">/</span>
        <a href="{{ path('product_index', {categorie: product.category.slug}) }}">{{ product.category.name }}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{{ product.name }}</span>
    </nav>

    <div class="product-detail">
        <div class="product-detail__media">
            {% include 'product/_image.html.twig' with {product: product, large: true} %}
        </div>

        <div class="product-detail__info">
            {% include 'components/_page_header.html.twig' with {eyebrow: product.category.name, title: product.name} %}

            {# Variante présélectionnée : la première en stock. Sans choix, c'est la seule variante proposée. #}
            {% set selected_variant = product.firstVariantInStock %}

            <div class="product-detail__price-row">
                {% if product.hasVariantChoice %}
                    <span class="price price--lg">{{ product.hasVariedPrices ? 'À partir de ' }}{{ product.fromPrice|price }}</span>
                    {% if not product.inStock %}
                        <span class="badge badge--danger">Rupture de stock</span>
                    {% endif %}
                {% else %}
                    <span class="price price--lg">{{ product.fromPrice|price }}</span>
                    {% if selected_variant %}
                        <span class="badge badge--success">En stock · {{ selected_variant.stock }} disponible{{ selected_variant.stock > 1 ? 's' }}</span>
                    {% else %}
                        <span class="badge badge--danger">Rupture de stock</span>
                    {% endif %}
                {% endif %}
            </div>

            {% if product.description %}
                <p class="product-detail__description">{{ product.description }}</p>
            {% endif %}

            {% if selected_variant %}
                <form method="post" action="{{ path('cart_add', {id: product.id}) }}" class="add-to-cart">
                    <input type="hidden" name="_token" value="{{ csrf_token('cart') }}">
                    {% if product.hasVariantChoice %}
                        {# Boutons radio : le choix se fait sans JavaScript, chaque option affiche son prix et sa disponibilité #}
                        <fieldset class="variant-choice">
                            <legend class="variant-choice__legend">Choisissez une variante</legend>
                            {% for variant in product.activeVariants %}
                                <label class="variant-choice__option">
                                    <input type="radio" name="variant" value="{{ variant.id }}" required{{ variant is same as(selected_variant) ? ' checked' }}{{ not variant.inStock ? ' disabled' }}>
                                    <span class="variant-choice__label">{{ variant.label }}</span>
                                    <span class="variant-choice__price">{{ variant.effectivePrice|price }}</span>
                                    {% if variant.inStock %}
                                        <span class="badge badge--success">{{ variant.stock }} disponible{{ variant.stock > 1 ? 's' }}</span>
                                    {% else %}
                                        <span class="badge badge--danger">Rupture de stock</span>
                                    {% endif %}
                                </label>
                            {% endfor %}
                        </fieldset>
                    {% else %}
                        <input type="hidden" name="variant" value="{{ selected_variant.id }}">
                    {% endif %}
                    <div class="add-to-cart__row">
                        <div class="field">
                            <label for="quantity">Quantité</label>
                            <input type="number" id="quantity" name="quantity" value="1" min="1"{% if not product.hasVariantChoice %} max="{{ selected_variant.stock }}"{% endif %} required class="input input--quantity">
                        </div>
                        <button type="submit" class="btn btn--primary btn--lg add-to-cart__submit">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6h15l-1.5 9h-12z"/><path d="M6 6 5 3H2"/><circle cx="9" cy="20" r="1.5"/><circle cx="18" cy="20" r="1.5"/></svg>
                        Ajouter au panier
                        </button>
                    </div>
                </form>
            {% else %}
                <p class="product-detail__description">Ce produit est momentanément indisponible. Découvrez les autres produits de la catégorie « {{ product.category.name }} ».</p>
                <a href="{{ path('product_index', {categorie: product.category.slug}) }}" class="btn btn--secondary">Voir la catégorie {{ product.category.name }}</a>
            {% endif %}

            {# Réassurance : uniquement ce que le site fait réellement #}
            <ul class="assurance assurance--compact" aria-label="Bon à savoir">
                <li class="assurance__item">
                    <span class="assurance__icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h13v10H3z"/><path d="M16 10h3l2 3v4h-5"/><circle cx="7" cy="18" r="1.5"/><circle cx="18" cy="18" r="1.5"/></svg></span>
                    <span><span class="assurance__title">Livraison en France</span><span class="assurance__text">Adresse demandée au moment de commander.</span></span>
                </li>
                <li class="assurance__item">
                    <span class="assurance__icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5"/></svg></span>
                    <span><span class="assurance__title">Annulation libre avant paiement</span><span class="assurance__text">Vos articles restent réservés en attendant le paiement.</span></span>
                </li>
                <li class="assurance__item">
                    <span class="assurance__icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg></span>
                    <span><span class="assurance__title">Paiement simulé</span><span class="assurance__text">Boutique de démonstration : aucune carte bancaire demandée.</span></span>
                </li>
            </ul>
        </div>
    </div>
{% endblock %}