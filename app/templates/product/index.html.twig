{% extends 'base.html.twig' %}

{% block title %}Catalogue{% endblock %}

{% block body %}
    <h1>Catalogue</h1>

    <ul>
        {% for product in products %}
            <li>
                <a href="{{ path('product_show', {slug: product.slug}) }}"><strong>{{ product.name }}</strong></a>
                ({{ product.category.name }}) : {{ product.price|price }}
                {% if not product.inStock %}
                    <em>Rupture de stock</em>
                {% endif %}
            </li>
        {% else %}
            <li>Aucun produit pour le moment.</li>
        {% endfor %}
    </ul>
{% endblock %}