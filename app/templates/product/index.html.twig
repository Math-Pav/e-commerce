{% extends 'base.html.twig' %}

{% block title -%}
    {{ catalog.search ? 'Recherche « ' ~ catalog.search ~ ' »' : 'Catalogue' }}
    {{- currentCategory ? ' – ' ~ currentCategory.name }}
    {{- catalog.page > 1 ? ' – page ' ~ catalog.page }}
{%- endblock %}

{% block body %}
    {% include 'components/_page_header.html.twig' with {
        eyebrow: 'Papeterie et objets du quotidien',
        title: 'Le catalogue',
        title_modifier: 'xl',
        lead: 'Mugs, carnets et stylos pour accompagner vos journées de travail.',
    } %}

    {# Formulaire en GET : il ne modifie rien, il construit seulement l'adresse de la page de résultats #}
    <form method="get" action="{{ path('product_index') }}" class="catalog-filters" role="search" aria-label="Rechercher et trier le catalogue">
        {% if currentCategory %}
            <input type="hidden" name="categorie" value="{{ currentCategory.slug }}">
        {% endif %}
        <div class="field catalog-filters__search">
            <label for="catalog-search">Rechercher un produit</label>
            <div class="catalog-filters__row">
                <input type="search" id="catalog-search" name="q" value="{{ catalog.search }}" maxlength="{{ constant('App\\Model\\CatalogQuery::SEARCH_MAX_LENGTH') }}" placeholder="Mug, carnet, stylo…" enterkeyhint="search" class="input">
                <button type="submit" class="btn btn--primary">Rechercher</button>
            </div>
        </div>
        <div class="field catalog-filters__sort">
            <label for="catalog-sort">Trier par</label>
            <div class="catalog-filters__row">
                <select id="catalog-sort" name="tri" class="input">
                    {% for sort in sorts %}
                        <option value="{{ sort.value }}" {{ sort == catalog.sort ? 'selected' }}>{{ sort.label }}</option>
                    {% endfor %}
                </select>
                <button type="submit" class="btn btn--secondary">Trier</button>
            </div>
        </div>
    </form>

    <div class="toolbar">
        <nav class="chips" aria-label="Filtrer par catégorie">
            <a href="{{ path('product_index', catalog.withCategory(null).toRouteParameters) }}" class="chip" aria-current="{{ currentCategory is null ? 'page' : 'false' }}">Tous les produits</a>
            {% for category in categories %}
                <a href="{{ path('product_index', catalog.withCategory(category.slug).toRouteParameters) }}" class="chip" aria-current="{{ currentCategory and currentCategory.id == category.id ? 'page' : 'false' }}">{{ category.name }}</a>
            {% endfor %}
        </nav>
        <p class="toolbar__count">
            {{ pagination.totalItems }} produit{{ pagination.totalItems > 1 ? 's' }}
            {%- if pagination.lastPage > 1 %} · page {{ pagination.currentPage }} sur {{ pagination.lastPage }}{% endif %}
        </p>
    </div>

    {% if catalog.search and pagination.totalItems > 0 %}
        <p class="search-summary">
            Résultats pour « <strong>{{ catalog.search }}</strong> »
            <a href="{{ path('product_index', catalog.withoutSearch.toRouteParameters) }}">Effacer la recherche</a>
        </p>
    {% endif %}

    {% if pagination.totalItems == 0 %}
        {% if catalog.search %}
            {% include 'components/_empty_state.html.twig' with {
                message: 'Aucun produit ne correspond à « ' ~ catalog.search ~ ' ». Vérifiez l\'orthographe ou essayez un mot plus court.',
                action: {url: path('product_index'), label: 'Réinitialiser la recherche et les filtres'},
            } %}
        {% else %}
            {% include 'components/_empty_state.html.twig' with {message: 'Aucun produit pour le moment.'} %}
        {% endif %}
    {% else %}
        <ul class="product-grid">
            {% for product in products %}
                <li>
                    <a href="{{ path('product_show', {slug: product.slug}) }}" class="product-card">
                        <div class="product-card__visual">
                            {% include 'product/_image.html.twig' with {product: product} %}
                            {% if not product.inStock %}
                                <span class="badge badge--danger product-card__badge">Rupture de stock</span>
                            {% endif %}
                        </div>
                        <span class="product-card__category">{{ product.category.name }}</span>
                        <span class="product-card__name">{{ product.name }}</span>
                        <span class="product-card__price">{{ product.hasVariedPrices ? 'À partir de ' }}{{ product.fromPrice|price }}</span>
                    </a>
                </li>
            {% endfor %}
        </ul>

        {% include 'product/_pagination.html.twig' %}
    {% endif %}
{% endblock %}