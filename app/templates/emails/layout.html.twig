{#
    Gabarit commun des e-mails HTML.
    Les messageries ignorent souvent les feuilles de style : tout est écrit en styles en ligne,
    avec des tableaux pour la mise en page (seule méthode fiable dans Outlook et Gmail).
    Les couleurs reprennent les jetons de assets/styles/app.css.
#}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ email.subject }}</title>
</head>
<body style="margin:0; padding:0; background:#f2ebdf; color:#1c1a17; font-family:Arial, Helvetica, sans-serif; font-size:16px; line-height:1.5;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f2ebdf;">
        <tr>
            <td align="center" style="padding:24px 16px;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:600px; background:#ffffff; border:1px solid #e6ddcf; border-radius:12px;">
                    <tr>
                        <td style="padding:24px 32px; border-bottom:1px solid #e6ddcf;">
                            <a href="{{ url('product_index') }}" style="color:#1c1a17; font-size:20px; font-weight:bold; text-decoration:none;">Atelier Papier</a>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding:32px;">
                            {% block content %}{% endblock %}
                        </td>
                    </tr>
                    <tr>
                        <td style="padding:16px 32px; border-top:1px solid #e6ddcf; color:#6a6158; font-size:13px;">
                            Cet e-mail vous a été envoyé automatiquement par Atelier Papier, merci de ne pas y répondre.
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
