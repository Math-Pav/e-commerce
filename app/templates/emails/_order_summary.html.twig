{# Récapitulatif d'une commande : lignes, total et adresse de livraison. Paramètre : order #}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse; margin:24px 0 0; font-size:15px;">
    <tr>
        <th align="left" style="padding:8px 0; border-bottom:1px solid #c9ced5; color:#5b6370; font-weight:normal;">Produit</th>
        <th align="right" style="padding:8px 0; border-bottom:1px solid #c9ced5; color:#5b6370; font-weight:normal;">Quantité</th>
        <th align="right" style="padding:8px 0; border-bottom:1px solid #c9ced5; color:#5b6370; font-weight:normal;">Sous-total</th>
    </tr>
    {% for item in order.items %}
        <tr>
            <td style="padding:8px 0; border-bottom:1px solid #e3e5e8;">
                {{ item.productName }}<br>
                <span style="color:#5b6370; font-size:13px;">{{ item.unitPrice|price }} l'unité</span>
            </td>
            <td align="right" style="padding:8px 0; border-bottom:1px solid #e3e5e8;">{{ item.quantity }}</td>
            <td align="right" style="padding:8px 0; border-bottom:1px solid #e3e5e8; white-space:nowrap;">{{ item.subtotal|price }}</td>
        </tr>
    {% endfor %}
    <tr>
        <td colspan="2" align="right" style="padding:12px 0 0; font-weight:bold;">Total</td>
        <td align="right" style="padding:12px 0 0; font-weight:bold; white-space:nowrap;">{{ order.totalAmount|price }}</td>
    </tr>
</table>

<h2 style="margin:24px 0 8px; font-size:18px;">Adresse de livraison</h2>
<p style="margin:0; color:#3d434c;">
    {{ order.shippingFullName }}<br>
    {{ order.shippingAddress }}<br>
    {{ order.shippingPostalCode }} {{ order.shippingCity }}
</p>
