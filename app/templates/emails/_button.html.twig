{# Lien présenté comme un bouton. Paramètres : url (absolue), label #}
<table role="presentation" cellpadding="0" cellspacing="0" style="margin:24px 0 0;">
    <tr>
        <td style="background:#1f4a3a; border-radius:10px;">
            <a href="{{ url }}" style="display:inline-block; padding:12px 20px; color:#ffffff; font-weight:bold; text-decoration:none;">{{ label }}</a>
        </td>
    </tr>
</table>
