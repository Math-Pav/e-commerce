{% extends 'base.html.twig' %}

{% block title %}Mes jetons d'accès à l'API{% endblock %}

{% block body %}
    {% include 'components/_page_header.html.twig' with {
        back: {url: path('account_index'), label: 'Retour à mon compte'},
        title: 'Mes jetons d\'accès à l\'API',
        lead: 'Un jeton permet à une application (par exemple sur votre téléphone) de consulter vos commandes sans votre mot de passe. Il est valable ' ~ lifetimeDays ~ ' jours ; vous pouvez en avoir ' ~ maxActiveTokens ~ ' actifs au plus.',
    } %}

    {% if plainToken %}
        <div class="callout" role="status">
            <div>
                <p class="callout__title">Votre nouveau jeton</p>
                <p class="callout__text">Copiez-le maintenant : il ne sera plus jamais affiché. Ne le partagez avec personne.</p>
            </div>
            <div class="field callout__field">
                <label for="new-api-token">Jeton d'accès</label>
                <input type="text" id="new-api-token" class="input" value="{{ plainToken }}" readonly>
            </div>
        </div>
    {% endif %}

    <div class="layout-split">
        <section class="layout-split__main" aria-labelledby="tokens-title">
            <h2 id="tokens-title" class="section-title">Mes jetons</h2>

            {% if apiTokens is empty %}
                {% include 'components/_empty_state.html.twig' with {message: 'Vous n\'avez aucun jeton. Créez-en un avec le formulaire « Créer un jeton ».'} %}
            {% else %}
                {% embed 'components/_table.html.twig' with {columns: [
                    {label: 'Nom'},
                    {label: 'Début du jeton'},
                    {label: 'Créé le'},
                    {label: 'Dernière utilisation'},
                    {label: 'Expire le'},
                    {label: 'Actions', hidden: true},
                ]} %}
                    {% block body %}
                        {% for apiToken in apiTokens %}
                            <tr>
                                <td>{{ apiToken.name }}</td>
                                <td><code>{{ apiToken.tokenPrefix }}…</code></td>
                                <td>{{ apiToken.createdAt|date('d/m/Y') }}</td>
                                <td>{{ apiToken.lastUsedAt ? apiToken.lastUsedAt|date('d/m/Y à H:i') : 'Jamais' }}</td>
                                <td>
                                    {% if apiToken.expired %}
                                        <span class="badge badge--danger">Expiré</span>
                                    {% else %}
                                        {{ apiToken.expiresAt|date('d/m/Y') }}
                                    {% endif %}
                                </td>
                                <td>
                                    <form method="post" action="{{ path('account_api_token_revoke', {id: apiToken.id}) }}" class="table__actions">
                                        <input type="hidden" name="_token" value="{{ csrf_token('revoke-api-token') }}">
                                        <button type="submit" class="btn btn--danger">Révoquer<span class="visually-hidden"> le jeton « {{ apiToken.name }} »</span></button>
                                    </form>
                                </td>
                            </tr>
                        {% endfor %}
                    {% endblock %}
                {% endembed %}
            {% endif %}
        </section>

        <section class="layout-split__aside panel" aria-labelledby="new-token-title">
            <h2 id="new-token-title" class="section-title">Créer un jeton</h2>

            {{ form_start(form, {attr: {class: 'form'}}) }}
                {{ form_row(form.name) }}
                <button type="submit" class="btn btn--primary btn--block">Créer le jeton</button>
            {{ form_end(form) }}
        </section>
    </div>
{% endblock %}
