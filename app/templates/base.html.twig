<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Boutique{% endblock %}</title>
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}{% endblock %}
    </head>
    <body>
        <nav>
            <a href="{{ path('product_index') }}">Catalogue</a>
            | <a href="{{ path('cart_show') }}">Panier</a>
            {% if app.user %}
                | Connecté en tant que {{ app.user.firstName }}
                | <a href="{{ path('app_logout') }}">Se déconnecter</a>
            {% else %}
                | <a href="{{ path('app_login') }}">Se connecter</a>
                | <a href="{{ path('app_register') }}">Créer un compte</a>
            {% endif %}
        </nav>

        {% for type, messages in app.flashes(['success', 'error']) %}
            {% for message in messages %}
                <p class="flash flash-{{ type }}"><strong>{{ message }}</strong></p>
            {% endfor %}
        {% endfor %}

        {% block body %}{% endblock %}
    </body>
</html>