<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Boutique{% endblock %} · Atelier Papier</title>
        <meta name="description" content="{% block meta_description %}Atelier Papier : mugs, carnets et stylos pour accompagner vos journées de travail.{% endblock %}">
        <meta name="theme-color" content="#1f4a3a">
        {# Aucune police ni ressource externe : les polices viennent du système (ADR 0024), compatible avec une CSP stricte #}
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        {% set route = app.request.attributes.get('_route') %}
        {% set cart_count = cart_item_count() %}

        <a href="#contenu" class="skip-link">Aller au contenu</a>

        <div class="site">
            {# Bandeau honnête : la boutique est une démonstration, le paiement est simulé (ADR 0003) #}
            <div class="announcement">
                <p class="container announcement__inner">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7h13v10H3z"/><path d="M16 10h3l2 3v4h-5"/><circle cx="7" cy="18" r="1.5"/><circle cx="18" cy="18" r="1.5"/></svg>
                    Livraison en France · Boutique de démonstration : le paiement est simulé
                </p>
            </div>

            <header class="site-header">
                <div class="container site-header__inner">
                    {% include 'components/_logo.html.twig' %}

                    {#
                        Ordre des liens : le catalogue, puis le compte, puis le panier (toujours visible, à droite).
                        Les liens du compte sont regroupés dans un menu <details> : il s'ouvre et se ferme sans JavaScript,
                        ce qui garde l'en-tête sur deux lignes au plus, même sur un téléphone de 375 px.
                    #}
                    <nav class="site-nav" aria-label="Navigation principale">
                        <a href="{{ path('product_index') }}" class="site-nav__link" aria-current="{{ route starts with 'product' ? 'page' : 'false' }}">Catalogue</a>
                        {% if app.user %}
                            <details class="account-menu">
                                <summary class="site-nav__link account-menu__toggle">
                                    <span class="avatar" aria-hidden="true">{{ app.user.firstName|first|upper }}{{ app.user.lastName|first|upper }}</span>
                                    <span class="account-menu__name"><span class="visually-hidden">Connecté en tant que </span>{{ app.user.firstName }}<span class="visually-hidden"> : menu du compte</span></span>
                                    <svg class="account-menu__chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                                </summary>
                                <ul class="account-menu__list">
                                    <li><a href="{{ path('order_index') }}" class="account-menu__link" aria-current="{{ route starts with 'order' ? 'page' : 'false' }}">Mes commandes</a></li>
                                    <li><a href="{{ path('account_index') }}" class="account-menu__link" aria-current="{{ route starts with 'account' ? 'page' : 'false' }}">Mon compte</a></li>
                                    {% if is_granted('ROLE_ADMIN') %}
                                        <li><a href="{{ path('admin_dashboard') }}" class="account-menu__link" aria-current="{{ route starts with 'admin' ? 'page' : 'false' }}">Administration</a></li>
                                    {% endif %}
                                    <li class="account-menu__separator"><a href="{{ path('app_logout') }}" class="account-menu__link">Se déconnecter</a></li>
                                </ul>
                            </details>
                        {% else %}
                            <a href="{{ path('app_login') }}" class="site-nav__link" aria-current="{{ route == 'app_login' ? 'page' : 'false' }}">Se connecter</a>
                            {# Bouton discret sur grand écran ; masqué sous 640 px (CSS), où la page de connexion propose l'inscription #}
                            <a href="{{ path('app_register') }}" class="btn btn--secondary site-nav__register" aria-current="{{ route == 'app_register' ? 'page' : 'false' }}">Créer un compte</a>
                        {% endif %}
                        <a href="{{ path('cart_show') }}" class="cart-link" aria-current="{{ route == 'cart_show' ? 'page' : 'false' }}">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6h15l-1.5 9h-12z"/><path d="M6 6 5 3H2"/><circle cx="9" cy="20" r="1.5"/><circle cx="18" cy="20" r="1.5"/></svg>
                            <span class="cart-link__label">Panier</span>
                            {% if cart_count > 0 %}
                                <span class="cart-link__count">{{ cart_count }}<span class="visually-hidden"> articles</span></span>
                            {% endif %}
                        </a>
                    </nav>
                </div>
            </header>

            <main class="site-main" id="contenu" tabindex="-1">
                <div class="container">
                    {% for type, messages in app.flashes(['success', 'error']) %}
                        {% for message in messages %}
                            <div class="flash flash--{{ type }}" role="{{ type == 'error' ? 'alert' : 'status' }}">{{ message }}</div>
                        {% endfor %}
                    {% endfor %}

                    {% block body %}{% endblock %}
                </div>
            </main>

            <footer class="site-footer">
                <div class="container site-footer__inner">
                    <div class="site-footer__brand">
                        {% include 'components/_logo.html.twig' %}
                        <p class="site-footer__text">Mugs, carnets et stylos choisis pour accompagner vos journées de travail. Projet d'apprentissage : les commandes sont réelles, le paiement est simulé.</p>
                    </div>
                    <nav aria-labelledby="footer-shop-title">
                        <h2 id="footer-shop-title" class="site-footer__title">La boutique</h2>
                        <ul class="site-footer__list">
                            <li><a href="{{ path('product_index') }}" class="site-footer__link">Tout le catalogue</a></li>
                            <li><a href="{{ path('product_index', {tri: 'nouveautes'}) }}" class="site-footer__link">Nouveautés</a></li>
                            <li><a href="{{ path('cart_show') }}" class="site-footer__link">Mon panier</a></li>
                        </ul>
                    </nav>
                    <nav aria-labelledby="footer-account-title">
                        <h2 id="footer-account-title" class="site-footer__title">Mon espace</h2>
                        <ul class="site-footer__list">
                            {% if app.user %}
                                <li><a href="{{ path('account_index') }}" class="site-footer__link">Mon compte</a></li>
                                <li><a href="{{ path('order_index') }}" class="site-footer__link">Mes commandes</a></li>
                                <li><a href="{{ path('account_api_token_index') }}" class="site-footer__link">Accès à l'API</a></li>
                            {% else %}
                                <li><a href="{{ path('app_login') }}" class="site-footer__link">Se connecter</a></li>
                                <li><a href="{{ path('app_register') }}" class="site-footer__link">Créer un compte</a></li>
                            {% endif %}
                        </ul>
                    </nav>
                    <div>
                        <h2 class="site-footer__title">Bon à savoir</h2>
                        <ul class="site-footer__list site-footer__facts">
                            <li>Livraison en France</li>
                            <li>Annulation possible tant que la commande n'est pas payée</li>
                            <li>Facture PDF pour chaque commande payée</li>
                        </ul>
                    </div>
                </div>
                <div class="site-footer__bottom">
                    <div class="container site-footer__bottom-inner">
                        <span>© {{ 'now'|date('Y') }} Atelier Papier</span>
                        <span>Boutique de démonstration · Paiement simulé, aucune carte bancaire demandée</span>
                    </div>
                </div>
            </footer>
        </div>
    </body>
</html>