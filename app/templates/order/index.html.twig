{% extends 'base.html.twig' %}

{% block title %}Mes commandes{% endblock %}

{% block body %}
    {% include 'components/_page_header.html.twig' with {title: 'Mes commandes'} %}

    {% if orders is empty %}
        {% include 'components/_empty_state.html.twig' with {message: 'Vous n\'avez pas encore passé de commande.', action: {url: path('product_index'), label: 'Découvrir le catalogue'}} %}
    {% else %}
        {% embed 'components/_table.html.twig' with {columns: [
            {label: 'Référence'},
            {label: 'Date'},
            {label: 'Statut'},
            {label: 'Total', num: true},
        ]} %}
            {% block body %}
                {% for order in orders %}
                    <tr>
                        <td><a href="{{ path('order_show', {reference: order.reference}) }}">{{ order.reference }}</a></td>
                        <td>{{ order.createdAt|date('d/m/Y') }}</td>
                        <td>{% include 'order/_status_badge.html.twig' with {status: order.status} %}</td>
                        <td class="num">{{ order.totalAmount|price }}</td>
                    </tr>
                {% endfor %}
            {% endblock %}
        {% endembed %}
    {% endif %}
{% endblock %}
