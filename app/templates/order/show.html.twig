{% extends 'base.html.twig' %}

{% block title %}Commande {{ order.reference }}{% endblock %}

{% block body %}
    {% embed 'components/_page_header.html.twig' with {
        back: {url: path('order_index'), label: 'Retour à mes commandes'},
        title: 'Commande ' ~ order.reference,
        lead: 'Passée le ' ~ order.createdAt|date('d/m/Y à H:i') ~ (order.paidAt ? ' · payée le ' ~ order.paidAt|date('d/m/Y à H:i')),
    } %}
        {% block actions %}
            {% include 'order/_status_badge.html.twig' with {status: order.status} %}
        {% endblock %}
    {% endembed %}

    {% if order.canBePaid or order.canBeCancelled %}
        <div class="callout">
            <div>
                <p class="callout__title">Il ne reste plus qu'à régler votre commande</p>
                <p class="callout__text">Vos articles sont réservés en attendant le paiement. Vous pouvez encore annuler la commande.</p>
            </div>
            {% if order.canBeCancelled %}
                <form method="post" action="{{ path('order_cancel', {reference: order.reference}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('cancel-order') }}">
                    <button type="submit" class="btn btn--danger btn--lg">Annuler la commande</button>
                </form>
            {% endif %}
            {% if order.canBePaid %}
                <form method="post" action="{{ path('order_pay', {reference: order.reference}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('pay-order') }}">
                    <button type="submit" class="btn btn--primary btn--lg">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
                        Payer la commande · {{ order.totalAmount|price }}
                    </button>
                </form>
            {% endif %}
        </div>
    {% endif %}

    <div class="layout-split">
        <section class="layout-split__main" aria-labelledby="items-title">
            <h2 id="items-title" class="section-title">Articles</h2>
            {% include 'order/_items_table.html.twig' with {order: order, with_images: true} %}
        </section>

        <aside class="layout-split__aside panel" aria-label="Livraison et facture">
            <h2 id="shipping-title" class="section-title">Livraison</h2>
            <address class="address">
                {{ order.shippingFullName }}<br>
                {{ order.shippingAddress }}<br>
                {{ order.shippingPostalCode }} {{ order.shippingCity }}
            </address>

            {% if invoice %}
                <h2 class="section-title">Facture</h2>
                <a href="{{ path('order_invoice', {reference: order.reference}) }}" class="btn btn--secondary" download>
                    Télécharger la facture {{ invoice.number }}<span class="visually-hidden"> (PDF)</span>
                </a>
            {% endif %}
        </aside>
    </div>
{% endblock %}