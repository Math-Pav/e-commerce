{% extends 'base.html.twig' %}

{% block title %}Finaliser ma commande{% endblock %}

{% block body %}
    {% include 'components/_checkout_steps.html.twig' with {current: 2} only %}

    {% include 'components/_page_header.html.twig' with {
        back: {url: path('cart_show'), label: 'Retour au panier'},
        title: 'Finaliser ma commande',
    } %}

    <div class="layout-split">
        <div class="layout-split__main form-card">
            <h2 class="section-title">Adresse de livraison</h2>

            {{ form_start(checkoutForm, {attr: {class: 'form'}}) }}
                {{ form_row(checkoutForm.fullName) }}
                {{ form_row(checkoutForm.address) }}
                <div class="form__inline">
                    {{ form_row(checkoutForm.postalCode) }}
                    {{ form_row(checkoutForm.city) }}
                </div>
                {# Case avant son libellé, comme l'usage le veut ; le <label for> garde le libellé cliquable #}
                <div>
                    {{ form_widget(checkoutForm.saveToProfile) }}
                    {{ form_label(checkoutForm.saveToProfile) }}
                </div>
                <button type="submit" class="btn btn--primary btn--lg btn--block">Valider la commande</button>
            {{ form_end(checkoutForm) }}
        </div>

        <aside class="layout-split__aside panel summary-panel" aria-label="Récapitulatif">
            <h2 class="section-title">Récapitulatif</h2>
            <ul class="summary-list">
                {% for line in cart.lines %}
                    <li class="summary-row">
                        <span class="summary-row__label summary-row__label--with-image">
                            {% include 'product/_image.html.twig' with {product: line.product, thumb: true} %}
                            {{ line.quantity }} × {{ line.variant.name }}
                        </span>
                        <span>{{ line.subtotal|price }}</span>
                    </li>
                {% endfor %}
            </ul>
            {% include 'cart/_discount.html.twig' %}
            <div class="summary-total">
                <span class="summary-total__label">Total</span>
                <span class="summary-total__amount">{{ cart.total|price }}</span>
            </div>
            <p class="note">Le paiement se fait à l'étape suivante, une fois la commande validée.</p>
            {% include 'cart/_assurance.html.twig' %}
        </aside>
    </div>
{% endblock %}