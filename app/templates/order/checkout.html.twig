{% extends 'base.html.twig' %}

{% block title %}Finaliser ma commande{% endblock %}

{% block body %}
    <h1>Finaliser ma commande</h1>

    <h2>Récapitulatif</h2>
    <ul>
        {% for line in cart.lines %}
            <li>{{ line.quantity }} × {{ line.product.name }} : {{ line.subtotal|price }}</li>
        {% endfor %}
    </ul>
    <p><strong>Total : {{ cart.total|price }}</strong></p>

    <h2>Adresse de livraison</h2>
    {{ form_start(checkoutForm) }}
        {{ form_widget(checkoutForm) }}
        <button type="submit">Valider la commande</button>
    {{ form_end(checkoutForm) }}

    <p><a href="{{ path('cart_show') }}">← Modifier mon panier</a></p>
{% endblock %}