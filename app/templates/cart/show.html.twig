{% extends 'base.html.twig' %}

{% block title %}Mon panier{% endblock %}

{% block body %}
    <h1 class="page-title">Mon panier</h1>

    {% if cart.empty %}
        <div class="empty-state">
            <p>Votre panier est vide.</p>
            <a href="{{ path('product_index') }}" class="btn btn--primary">Découvrir le catalogue</a>
        </div>
    {% else %}
        <div class="layout-split">
            <div class="layout-split__main">
                <ul class="cart-lines">
                    {% for line in cart.lines %}
                        <li class="cart-line">
                            {% include 'product/_image.html.twig' with {product: line.product} %}
                            <div class="cart-line__info">
                                <a href="{{ path('product_show', {slug: line.product.slug}) }}" class="cart-line__name">{{ line.variant.name }}</a>
                                <span class="cart-line__unit">{{ line.unitPrice|price }} l'unité</span>
                            </div>
                            <span class="cart-line__quantity">Quantité : <strong>{{ line.quantity }}</strong></span>
                            <span class="cart-line__subtotal">{{ line.subtotal|price }}</span>
                            <form method="post" action="{{ path('cart_remove', {id: line.variant.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('cart') }}">
                                <button type="submit" class="btn btn--secondary">Retirer<span class="visually-hidden"> {{ line.variant.name }} du panier</span></button>
                            </form>
                        </li>
                    {% endfor %}
                </ul>
            </div>

            <aside class="layout-split__aside panel" aria-label="Récapitulatif">
                <h2 class="section-title">Récapitulatif</h2>
                <ul class="summary-list">
                    {% for line in cart.lines %}
                        <li class="summary-row">
                            <span class="summary-row__label">{{ line.quantity }} × {{ line.variant.name }}</span>
                            <span>{{ line.subtotal|price }}</span>
                        </li>
                    {% endfor %}
                </ul>
                {% include 'cart/_discount.html.twig' %}
                {% if cart.promoCode %}
                    <form method="post" action="{{ path('cart_promo_remove') }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('cart') }}">
                        <button type="submit" class="btn btn--secondary btn--block">Retirer le code promo<span class="visually-hidden"> {{ cart.promoCode.code }}</span></button>
                    </form>
                {% else %}
                    <form method="post" action="{{ path('cart_promo_apply') }}" class="field">
                        <input type="hidden" name="_token" value="{{ csrf_token('cart') }}">
                        <label for="promo-code">Code promo</label>
                        <input type="text" id="promo-code" name="code" maxlength="30" autocomplete="off" required class="input">
                        <button type="submit" class="btn btn--secondary">Appliquer</button>
                    </form>
                {% endif %}
                <div class="summary-total">
                    <span class="summary-total__label">Total</span>
                    <span class="summary-total__amount">{{ cart.total|price }}</span>
                </div>
                <a href="{{ path('order_checkout') }}" class="btn btn--primary btn--block">Passer commande</a>
                <a href="{{ path('product_index') }}" class="back-link">Continuer mes achats</a>
            </aside>
        </div>
    {% endif %}
{% endblock %}