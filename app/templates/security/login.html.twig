{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
    <div class="auth-layout">
        <div class="auth-card">
            {% include 'components/_page_header.html.twig' with {title: 'Connexion', lead: 'Connectez-vous pour passer commande et suivre vos achats.'} %}

            {% if error %}
                {# Message fourni par Symfony selon la cause de l'échec, traduit via le domaine « security » #}
                <div class="flash flash--error" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            <form method="post" class="form">
                <div class="field">
                    <label for="username">E-mail</label>
                    <input type="email" id="username" name="_username" value="{{ last_username }}" autocomplete="email" required autofocus class="input">
                </div>
                <div class="field">
                    <label for="password">Mot de passe</label>
                    <input type="password" id="password" name="_password" autocomplete="current-password" required class="input">
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button type="submit" class="btn btn--primary btn--block">Se connecter</button>
            </form>

            <div class="auth-card__footer">
                <p>Pas encore de compte ?</p>
                <a href="{{ path('app_register') }}" class="btn btn--secondary btn--block">Créer un compte</a>
            </div>
        </div>
        {% include 'security/_auth_aside.html.twig' %}
    </div>
{% endblock %}