{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
    <div class="auth-card">
        <div class="page-header">
            <h1 class="page-title">Connexion</h1>
            <p class="lead">Connectez-vous pour passer commande et suivre vos achats.</p>
        </div>

        {% if error %}
            <div class="flash flash--error" role="alert">Identifiants invalides.</div>
        {% endif %}

        <form method="post" class="form">
            <div class="field">
                <label for="username">E-mail</label>
                <input type="email" id="username" name="_username" value="{{ last_username }}" autocomplete="email" required autofocus class="input">
            </div>
            <div class="field">
                <label for="password">Mot de passe</label>
                <input type="password" id="password" name="_password" autocomplete="current-password" required class="input">
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button type="submit" class="btn btn--primary btn--block">Se connecter</button>
        </form>

        <p class="auth-card__footer">Pas encore de compte ? <a href="{{ path('app_register') }}">Créer un compte</a></p>
    </div>
{% endblock %}