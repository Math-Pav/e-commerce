{#
    Facture convertie en PDF par dompdf (InvoicePdfGenerator).
    dompdf ne comprend que le CSS 2.1 : mise en page par tableaux, ni flexbox ni variables CSS.
    Les couleurs reprennent les jetons de assets/styles/app.css.
    Seules les données copiées dans la facture sont utilisées, jamais celles de la commande (qui peuvent changer).
#}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <title>Facture {{ invoice.number }}</title>
    <style>
        @page { margin: 32px 40px; }
        body { font-family: 'DejaVu Sans', sans-serif; font-size: 10px; color: #15181d; line-height: 1.45; }
        h1 { margin: 0; font-size: 22px; color: #2343d6; }
        table { width: 100%; border-collapse: collapse; }
        .muted { color: #5b6370; }
        .num { text-align: right; white-space: nowrap; }
        .header td { vertical-align: top; }
        .brand { font-size: 18px; font-weight: bold; }
        .meta td { padding: 2px 0; }
        .parties { margin-top: 24px; }
        .parties td { width: 50%; vertical-align: top; padding: 12px; background: #f5f6f8; border: 1px solid #e3e5e8; }
        .label { font-size: 8px; text-transform: uppercase; letter-spacing: 1px; color: #5b6370; margin-bottom: 4px; }
        .lines { margin-top: 24px; }
        .lines th { text-align: left; padding: 8px; background: #2343d6; color: #ffffff; font-size: 9px; }
        .lines td { padding: 8px; border-bottom: 1px solid #e3e5e8; }
        .totals { margin-top: 16px; width: 45%; margin-left: 55%; }
        .totals td { padding: 4px 8px; }
        .totals .grand td { padding-top: 8px; border-top: 2px solid #15181d; font-size: 12px; font-weight: bold; }
        .footer { margin-top: 32px; padding-top: 12px; border-top: 1px solid #e3e5e8; font-size: 8px; color: #5b6370; }
    </style>
</head>
<body>
    <table class="header">
        <tr>
            <td>
                <div class="brand">{{ invoice.sellerName }}</div>
                <div class="muted">
                    {{ invoice.sellerAddress }}<br>
                    {{ invoice.sellerPostalCode }} {{ invoice.sellerCity }}
                </div>
            </td>
            <td class="num">
                <h1>Facture</h1>
                <table class="meta">
                    <tr><td class="num muted">Numéro</td><td class="num"><strong>{{ invoice.number }}</strong></td></tr>
                    <tr><td class="num muted">Date</td><td class="num">{{ invoice.issuedAt|date('d/m/Y') }}</td></tr>
                    <tr><td class="num muted">Commande</td><td class="num">{{ invoice.orderReference }}</td></tr>
                </table>
            </td>
        </tr>
    </table>

    <table class="parties">
        <tr>
            <td>
                <div class="label">Vendeur</div>
                <strong>{{ invoice.sellerName }}</strong><br>
                {{ invoice.sellerAddress }}<br>
                {{ invoice.sellerPostalCode }} {{ invoice.sellerCity }}<br>
                SIRET : {{ invoice.sellerSiret }}<br>
                TVA intracommunautaire : {{ invoice.sellerVatNumber }}
            </td>
            <td>
                <div class="label">Facturé à</div>
                <strong>{{ invoice.customerName }}</strong><br>
                {{ invoice.billingAddress }}<br>
                {{ invoice.billingPostalCode }} {{ invoice.billingCity }}<br>
                {{ invoice.customerEmail }}
            </td>
        </tr>
    </table>

    <table class="lines">
        <thead>
            <tr>
                <th>Désignation</th>
                <th class="num">Prix unitaire TTC</th>
                <th class="num">Quantité</th>
                <th class="num">Total TTC</th>
            </tr>
        </thead>
        <tbody>
            {% for line in invoice.lines %}
                <tr>
                    <td>{{ line.displayName }}</td>
                    <td class="num">{{ line.unitPrice|price }}</td>
                    <td class="num">{{ line.quantity }}</td>
                    <td class="num">{{ line.totalAmount|price }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    <table class="totals">
        {% if invoice.discountAmount > 0 %}
            <tr><td>Sous-total TTC</td><td class="num">{{ invoice.subtotalAmount|price }}</td></tr>
            <tr><td>Remise{% if invoice.discountCode %} ({{ invoice.discountCode }}){% endif %}</td><td class="num">− {{ invoice.discountAmount|price }}</td></tr>
        {% endif %}
        <tr><td>Total HT</td><td class="num">{{ invoice.totalExcludingTax|price }}</td></tr>
        <tr><td>TVA {{ invoice.vatRate }} %</td><td class="num">{{ invoice.vatAmount|price }}</td></tr>
        <tr class="grand"><td>Total TTC</td><td class="num">{{ invoice.totalIncludingTax|price }}</td></tr>
    </table>

    <p class="muted">Facture acquittée le {{ invoice.issuedAt|date('d/m/Y') }} par carte bancaire.</p>

    <div class="footer">
        {{ invoice.sellerName }} · {{ invoice.sellerAddress }}, {{ invoice.sellerPostalCode }} {{ invoice.sellerCity }}
        · SIRET {{ invoice.sellerSiret }} · TVA {{ invoice.sellerVatNumber }}
    </div>
</body>
</html>
