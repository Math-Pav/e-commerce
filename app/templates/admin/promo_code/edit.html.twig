{% extends 'admin/base.html.twig' %}

{% block title %}Modifier {{ promoCode.code }} · Administration{% endblock %}

{% block admin_content %}
    <div class="admin-form">
        <div class="page-header">
            <p class="eyebrow">Administration</p>
            <h1 class="page-title">Modifier le code promo</h1>
            <p class="lead">Utilisé {{ promoCode.usageCount }} fois. Les commandes déjà passées gardent leur remise.</p>
        </div>

        {% include 'admin/promo_code/_form.html.twig' with {button_label: 'Enregistrer les modifications'} %}
    </div>
{% endblock %}
