{% extends 'admin/base.html.twig' %}

{% block title %}Produits · Administration{% endblock %}

{% block admin_content %}
    <div class="page-toolbar">
        <div class="page-header">
            <p class="eyebrow">Administration</p>
            <h1 class="page-title">Produits</h1>
        </div>
        <div class="toolbar">
            <p class="toolbar__count">{{ products|length }} produit{{ products|length > 1 ? 's' }}</p>
            <a href="{{ path('admin_product_new') }}" class="btn btn--primary">Nouveau produit</a>
        </div>
    </div>

    <div class="table-wrapper">
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">Produit</th>
                    <th scope="col">Catégorie</th>
                    <th scope="col" class="num">Prix</th>
                    <th scope="col" class="num">Stock</th>
                    <th scope="col">Statut</th>
                    <th scope="col"><span class="visually-hidden">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                {% for product in products %}
                    <tr>
                        <td><strong>{{ product.name }}</strong></td>
                        <td>{{ product.category.name }}</td>
                        <td class="num">{{ product.price|price }}</td>
                        <td class="num">
                            {# Stock total des variantes actives ; le détail par variante est dans « Variantes » #}
                            {% if not product.inStock %}
                                <span class="stock stock--out">Rupture</span>
                            {% else %}
                                {{ product.totalStock }}
                            {% endif %}
                        </td>
                        <td>
                            {% if product.active %}
                                <span class="badge badge--success">En ligne</span>
                            {% else %}
                                <span class="badge badge--neutral">Désactivé</span>
                            {% endif %}
                        </td>
                        <td>
                            <div class="table__actions">
                                <a href="{{ path('admin_product_edit', {id: product.id}) }}" class="btn btn--secondary">Modifier<span class="visually-hidden"> {{ product.name }}</span></a>
                                {% set status_action = product.active ? 'deactivate' : 'activate' %}
                                <form method="post" action="{{ path('admin_product_' ~ status_action, {id: product.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('product-status') }}">
                                    <button type="submit" class="btn btn--secondary">{{ product.active ? 'Désactiver' : 'Activer' }}<span class="visually-hidden"> {{ product.name }}</span></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
