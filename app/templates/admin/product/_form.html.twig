{{ form_start(productForm, {attr: {class: 'form'}}) }}
    {{ form_row(productForm.name) }}
    {{ form_row(productForm.category) }}
    <div class="form__inline">
        {{ form_row(productForm.price) }}
        {% if productForm.stock is defined %}
            {{ form_row(productForm.stock) }}
        {% endif %}
    </div>
    {{ form_row(productForm.description) }}
    {% if product is defined and product.imageFilename %}
        <figure class="image-preview">
            {% include 'product/_image.html.twig' with {product: product} %}
            <figcaption class="help-text">Photo actuelle</figcaption>
        </figure>
    {% endif %}
    {{ form_row(productForm.image) }}
    {% if productForm.removeImage is defined %}
        {{ form_row(productForm.removeImage) }}
    {% endif %}
    <button type="submit" class="btn btn--primary">{{ button_label }}</button>
{{ form_end(productForm) }}

<a href="{{ path('admin_product_index') }}" class="back-link">← Retour à la liste des produits</a>
