{% extends 'admin/base.html.twig' %}

{% block title %}Modifier {{ product.name }} · Administration{% endblock %}

{% block admin_content %}
    <div class="admin-form">
        <div class="page-header">
            <p class="eyebrow">Administration</p>
            <h1 class="page-title">Modifier le produit</h1>
            <p class="lead">Adresse de la fiche : <code>/produits/{{ product.slug }}</code> (elle ne change pas si le nom change).</p>
        </div>

        {% include 'admin/product/_form.html.twig' with {button_label: 'Enregistrer les modifications'} %}
    </div>
{% endblock %}
