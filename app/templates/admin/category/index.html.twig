{% extends 'admin/base.html.twig' %}

{% block title %}Catégories · Administration{% endblock %}

{% block admin_content %}
    {% embed 'components/_page_header.html.twig' with {eyebrow: 'Administration', title: 'Catégories'} %}
        {% block actions %}
            <div class="toolbar">
                <p class="toolbar__count">{{ rows|length }} catégorie{{ rows|length > 1 ? 's' }}</p>
                <a href="{{ path('admin_category_new') }}" class="btn btn--primary">Nouvelle catégorie</a>
            </div>
        {% endblock %}
    {% endembed %}

    {% if rows is empty %}
        {% include 'components/_empty_state.html.twig' with {message: 'Aucune catégorie pour le moment.', action: {url: path('admin_category_new'), label: 'Créer une catégorie'}} %}
    {% else %}
        {% embed 'components/_table.html.twig' with {columns: [
            {label: 'Catégorie'},
            {label: 'Adresse'},
            {label: 'Produits', num: true},
            {label: 'Actions', hidden: true},
        ]} %}
            {% block body %}
                {% for row in rows %}
                    {% set category = row.category %}
                    <tr>
                        <td><strong>{{ category.name }}</strong></td>
                        <td><code>{{ category.slug }}</code></td>
                        <td class="num">{{ row.productCount }}</td>
                        <td>
                            <div class="table__actions">
                                <a href="{{ path('admin_category_edit', {id: category.id}) }}" class="btn btn--secondary">Modifier<span class="visually-hidden"> {{ category.name }}</span></a>
                                {# Le bouton reste visible si la catégorie n'est pas vide : le refus est expliqué par un message #}
                                <form method="post" action="{{ path('admin_category_delete', {id: category.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('category-delete') }}">
                                    <button type="submit" class="btn btn--danger">Supprimer<span class="visually-hidden"> {{ category.name }}</span></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            {% endblock %}
        {% endembed %}
    {% endif %}
{% endblock %}
