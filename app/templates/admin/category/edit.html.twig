{% extends 'admin/base.html.twig' %}

{% block title %}Renommer {{ category.name }} · Administration{% endblock %}

{% block admin_content %}
    <div class="admin-form">
        <div class="page-header">
            <p class="eyebrow">Administration</p>
            <h1 class="page-title">Renommer la catégorie</h1>
            <p class="lead">Adresse du filtre : <code>/produits?categorie={{ category.slug }}</code> (elle ne change pas si le nom change).</p>
        </div>

        {% include 'admin/category/_form.html.twig' with {button_label: 'Enregistrer le nouveau nom'} %}
    </div>
{% endblock %}
