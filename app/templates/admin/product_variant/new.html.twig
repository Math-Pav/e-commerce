{% extends 'admin/base.html.twig' %}

{% block title %}Nouvelle variante de {{ product.name }} · Administration{% endblock %}

{% block admin_content %}
    <div class="admin-form">
        {% include 'components/_page_header.html.twig' with {
            back: {url: path('admin_product_variant_index', {id: product.id}), label: 'Retour aux variantes de ' ~ product.name},
            eyebrow: 'Administration · ' ~ product.name,
            title: 'Nouvelle variante',
            lead: 'Prix du produit : ' ~ product.price|price ~ '. Une variante sans prix propre utilise ce prix.',
        } %}

        {% include 'admin/product_variant/_form.html.twig' with {button_label: 'Créer la variante'} %}
    </div>
{% endblock %}
