{% extends 'admin/base.html.twig' %}

{% block title %}Modifier {{ variant.name }} · Administration{% endblock %}

{% block admin_content %}
    <div class="admin-form">
        {% include 'components/_page_header.html.twig' with {
            back: {url: path('admin_product_variant_index', {id: variant.product.id}), label: 'Retour aux variantes de ' ~ variant.product.name},
            eyebrow: 'Administration · ' ~ variant.product.name,
            title: 'Modifier la variante',
            lead: 'Prix du produit : ' ~ variant.product.price|price ~ '. Les commandes déjà passées gardent leur libellé et leur prix.',
        } %}

        {% include 'admin/product_variant/_form.html.twig' with {button_label: 'Enregistrer les modifications'} %}
    </div>
{% endblock %}
