{% extends 'admin/base.html.twig' %}

{% block title %}Modifier {{ variant.name }} · Administration{% endblock %}

{% block admin_content %}
    <div class="admin-form">
        <div class="page-header">
            <p class="eyebrow">Administration · {{ variant.product.name }}</p>
            <h1 class="page-title">Modifier la variante</h1>
            <p class="lead">Prix du produit : {{ variant.product.price|price }}. Les commandes déjà passées gardent leur libellé et leur prix.</p>
        </div>

        {% include 'admin/product_variant/_form.html.twig' with {button_label: 'Enregistrer les modifications', product: variant.product} %}
    </div>
{% endblock %}
