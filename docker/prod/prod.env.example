# MODÈLE des variables de production. Ne contient aucun vrai secret.
#
# 1. Copier ce fichier HORS du dépôt Git, par exemple : /etc/ecommerce/prod.env (droits 600, lisible par root seul).
# 2. Remplacer chaque valeur "a-remplacer".
# 3. Lancer : docker compose -f compose.prod.yaml --env-file /etc/ecommerce/prod.env up -d
#
# Ne jamais versionner le fichier rempli. Voir docs/deploiement.md, section « Secrets ».

# Clé secrète de Symfony (CSRF, signatures, « se souvenir de moi »). 64 caractères hexadécimaux aléatoires :
#   openssl rand -hex 32
APP_SECRET=a-remplacer

# Base de données : mots de passe longs et aléatoires (openssl rand -base64 24 | tr -d '/+=')
DB_NAME=ecommerce
DB_USER=app
DB_PASSWORD=a-remplacer
DB_ROOT_PASSWORD=a-remplacer

# Vrai serveur d'envoi d'e-mails (SMTP du prestataire), par exemple :
#   smtp://identifiant:mot-de-passe@smtp.prestataire.fr:587
MAILER_DSN=a-remplacer

# Adresse publique du site, en HTTPS (liens absolus des e-mails)
DEFAULT_URI=https://www.exemple.fr

# Port publié par Nginx sur le serveur (80 si Nginx reçoit directement le trafic,
# un autre port si un proxy HTTPS est installé sur la même machine)
HTTP_PORT=80

# Adresse IP du proxy HTTPS placé devant Nginx (laisser vide s'il n'y en a pas)
SYMFONY_TRUSTED_PROXIES=
